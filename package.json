{
  "name": "timerbar",
  "version": "1.0.0",
  "packageManager": "pnpm@10.9.0+sha512.0486e394640d3c1fb3c9d43d49cf92879ff74f8516959c235308f5a8f62e2e19528a65cdc2a3058f587cde71eba3d5b56327c8c33a97e4c4051ca48a10ca2d5f",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "prepare": "husky || true",
    "start": "electron .",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "test": "node --test 'src/**/*.test.js' '*.test.js'",
    "build": "electron-builder --dir",
    "build:mac": "electron-builder -m --config.mac.target=dmg --publish=never",
    "site:deploy": "bash scripts/deploy-site.sh"
  },
  "lint-staged": {
    "*.{js,cjs,html}": [
      "prettier --write",
      "eslint --fix --no-warn-ignored"
    ],
    "*.{json,md,yml,yaml,css}": "prettier --write --ignore-unknown"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron"
    ]
  },
  "main": "src/main.js",
  "type": "module",
  "license": "MIT",
  "dependencies": {
    "ansi-styles": "^6.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "electron": "^35.2.0",
    "electron-builder": "^26.0.12",
    "eslint": "^10.9.1",
    "eslint-plugin-html": "^8.2.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "knip": "^6.34.0",
    "lint-staged": "^17.5.0",
    "prettier": "^3.9.6"
  },
  "description": "A macOS menu bar timer with a Freebasing mode and Clippy-style coaching popups on SaaS, psychology and psychiatry"
}
